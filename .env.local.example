# Copy to .env.local and fill in, then:
#
#     docker compose --env-file .env.local up -d --build
#
# Do NOT rename this to .env. Compose reads .env automatically, which makes it
# the tempting choice, but .env is TRACKED in this repo (it carries upstream's
# dotenvx-encrypted values). A tracked file cannot be protected by .gitignore,
# so a token written there is one `git commit -a` away from a public repo.
# .env.local is ignored; .env is not and cannot be.

# Required
DISCORD_TOKEN=paste-your-bot-token-from-developers.gamevox.com

# Optional
OWNER_ID=
OWNER_NAME=

# Override only if you want to point at stage or local
GAMEVOX_API=https://bot-api.gamevox.com
GAMEVOX_GATEWAY=wss://gateway.gamevox.com
