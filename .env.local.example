# Copy to .env.local and fill in. docker-compose picks this up via the
# default env_file behavior (compose v2 reads .env from the same dir as
# docker-compose.yml automatically — name this file .env to use it).

# Required
DISCORD_TOKEN=paste-your-bot-token-from-developers.gamevox.com

# Optional
OWNER_ID=
OWNER_NAME=

# Override only if you want to point at stage or local
GAMEVOX_API=https://bot-api.gamevox.com
GAMEVOX_GATEWAY=wss://gateway.gamevox.com
